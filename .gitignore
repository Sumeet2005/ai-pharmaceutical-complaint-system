# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environment & caches
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend dependencies and build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Local uploads storage (preserve directory tracking via .gitkeep)
backend/app/uploads/*
!backend/app/uploads/.gitkeep
app/uploads/*
!app/uploads/.gitkeep

# Logs and databases
*.log
*.sqlite3

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
